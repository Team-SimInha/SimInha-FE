# Mapbox token is optional.
# Without it, the app falls back to free OpenFreeMap tiles.
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Spring Boot backend on Cloud Run.
VITE_BACKEND_URL=

# Report mode:
# - local: use deterministic frontend fallback report only
# - api: call /api/report, then fall back to local report if the API fails
VITE_REPORT_MODE=local
VITE_REPORT_API_PATH=/api/report

# Vercel serverless function env vars for api/report.js and api/classify-image.js.
# Set these in Vercel Project Settings > Environment Variables.
UPSTAGE_API_KEY=your_upstage_api_key_here
UPSTAGE_MODEL=solar-pro3

# Practice-image classification (vision LLM) — api/classify-image.js.
# OpenAI-compatible Chat Completions with a vision-capable model. On failure
# the frontend falls back to text-only keyword matching.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o-mini
# Override base URL for OpenAI-compatible gateways (e.g. runyourai).
# Leave unset to use OpenAI directly. Include the version path, no trailing slash.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend vision classification:
# - api (default): cross-validate uploaded image against the text description
# - off: skip vision, use keyword matching only
VITE_VISION_MODE=api
VITE_VISION_API_PATH=/api/classify-image
